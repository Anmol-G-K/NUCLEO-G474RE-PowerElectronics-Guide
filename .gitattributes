###############################################################################
# Line ending normalization
###############################################################################

* text=auto eol=lf

*.bat text eol=crlf

###############################################################################
# STM32 / C / Headers
###############################################################################

*.c         text diff=c
*.h         text diff=c
*.s         text
*.ld        text
*.mk        text
*.ioc       text
*.project   text
*.cproject  text
*.mxproject text

###############################################################################
# MATLAB / Simulink
###############################################################################

# MATLAB source files
*.m text linguist-language=MATLAB diff=matlab

# Simulink models (force MATLAB/Simulink classification, but keep binary)
*.slx  binary -diff linguist-language=MATLAB
*.slxc binary -diff linguist-language=MATLAB

# MAT files (binary data)
*.mat binary -diff

###############################################################################
# Build artifacts (should also be in .gitignore)
###############################################################################

*.o     binary -diff
*.elf   binary -diff
*.hex   binary -diff
*.bin   binary -diff
*.map   text
*.dep   text
*.su    text

###############################################################################
# STM32CubeIDE Debug folders
###############################################################################

Debug/**        binary
**/Debug/**     binary